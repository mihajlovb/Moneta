msgstr "Ова е валутата на самата сметка."

#: finance/templates/finance/account_form.html:6
msgid "Account color"
msgstr "Боја на сметката"

#: finance/templates/finance/account_form.html:6
msgid "Used to identify this account in the interface."
msgstr "Се користи за препознавање на сметката во интерфејсот."

#: finance/templates/finance/account_form.html:7
msgid "Include in net worth"
msgstr "Вклучи во вкупен имот"

#: finance/templates/finance/account_form.html:7
